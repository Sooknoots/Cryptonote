{
  "version": "1.0.0",
  "application": {
    "name": "Cryptonote",
    "description": "Secure Distributed Note Taking with AI Assistance",
    "offline_mode": true
  },
  "security": {
    "encryption": "AES-256-GCM",
    "key_derivation": "Argon2id",
    "certificate_path": "certs/cert.pem",
    "key_path": "certs/key.pem"
  },
  "ai_providers": {
    "ollama": {
      "enabled": true,
      "url": "http://localhost:11434",
      "default_model": "llama2",
      "timeout_enabled": true,
      "timeout_seconds": 30,
      "lifetime_license_required": true
    },
    "openai": {
      "enabled": false,
      "api_key_required": true,
      "default_model": "gpt-3.5-turbo"
    },
    "p2p": {
      "enabled": true,
      "port": 5000,
      "host": "localhost",
      "api_key_required": true,
      "rate_limiting": true,
      "max_requests_per_minute": 60
    }
  },
  "p2p_server": {
    "enabled": true,
    "port": 5000,
    "host": "0.0.0.0",
    "ssl_enabled": true,
    "certificate_file": "certs/cert.pem",
    "key_file": "certs/key.pem",
    "api_keys_required": true,
    "rate_limiting_enabled": true,
    "max_concurrent_requests": 10,
    "request_timeout": 300,
    "log_requests": true
  },
  "storage": {
    "default_database": "notes.enc",
    "backup_enabled": true,
    "auto_save_interval": 30,
    "max_file_size_mb": 100
  },
  "ui": {
    "theme": "dark",
    "font_size": 12,
    "window_size": "1200x800",
    "auto_clipboard_monitor": true,
    "notification_enabled": true
  },
  "logging": {
    "enabled": true,
    "level": "INFO",
    "max_file_size_mb": 10,
    "backup_count": 5,
    "log_requests": true,
    "log_performance": true
  },
  "performance": {
    "tps_tracking_enabled": true,
    "memory_monitoring": true,
    "cpu_monitoring": false
  },
  "integrations": {
    "google_drive": {
      "enabled": false,
      "credentials_required": true
    },
    "paypal": {
      "enabled": false,
      "sandbox_mode": true
    }
  },
  "offline_resources": {
    "ssl_certificates_generated": false,
    "default_models_available": false,
    "p2p_server_ready": false
  }
}